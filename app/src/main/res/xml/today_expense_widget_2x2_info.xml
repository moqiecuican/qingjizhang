<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 主档（今日支出）
  尺寸口径（1584 §3.2）：2×2 = minWidth/minHeight 110×110dp。
  **不写 targetCellWidth/Height**：上一轮平板卡片异常即由此引起。
  initialLayout 指加载态（1585「加载态」），收到 update 后换正式布局。
  updatePeriodMillis 保留 30min，仅作非小米设备的原生兜底（1584 §12.3）；小米侧由曝光刷新接管。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewImage="@drawable/widget_preview"
    android:description="@string/widget_2x2_desc"
    android:widgetCategory="home_screen" />

